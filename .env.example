# Runtime
NODE_ENV=development

# Application URLs
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Database
MONGODB_URI=mongodb://localhost:27017/education-web-app
MONGODB_PORT=27017
MONGO_DATABASE=education-web-app

# Authentication
# Replace this value before using a shared or production environment.
JWT_SECRET=change-this-secret-in-development
JWT_EXPIRE=7d

# Default process port (API Gateway). Service-specific ports below take priority.
PORT=5175

# Backend service ports
AUTH_PORT=5176
USER_PORT=5177
COURSE_PORT=5178
BLOG_PORT=5179
ENROLLMENT_PORT=5180
LEARNINGPATH_PORT=5181

# API Gateway -> service URLs
AUTH_SERVICE_URL=http://localhost:5176
USER_SERVICE_URL=http://localhost:5177
COURSE_SERVICE_URL=http://localhost:5178
BLOG_SERVICE_URL=http://localhost:5179
ENROLLMENT_SERVICE_URL=http://localhost:5180
LEARNING_PATH_SERVICE_URL=http://localhost:5181
